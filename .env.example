# ==============================================================================
# Carouselfy Environment Configuration Template
# Duplicate this file to .env and fill in your actual production credentials.
# NEVER commit .env to GitHub or public version control.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_URL=https://yourdomain.com
APP_SECRET=generate_a_random_32_character_secret_string

# Database Configuration (Hostinger MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_carouselfy
DB_USER=u123456789_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# AI API Configuration (OpenAI or compatible provider)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# Optional Lovable AI Gateway key
LOVABLE_API_KEY=

# Meta / Instagram Graph API Configuration
# Create an App at https://developers.facebook.com with "Instagram Graph API" permissions
INSTAGRAM_APP_ID=YOUR_FACEBOOK_APP_ID
INSTAGRAM_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/api/instagram/callback.php
# Graph API Version
INSTAGRAM_GRAPH_VERSION=v20.0

# Cron Security Token (Required to trigger /cron/publish_scheduled.php via web request)
CRON_SECRET=YOUR_CUSTOM_CRON_SECRET_TOKEN
